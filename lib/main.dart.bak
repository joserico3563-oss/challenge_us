class _ScheduleRow extends StatelessWidget {
  const _ScheduleRow({required this.schedule, required this.totalMembers});

  final GroupSchedule schedule;
  final int totalMembers;

  @override
  Widget build(BuildContext context) {
    final everyone = schedule.availableMembers >= totalMembers;
    final ratio =
        totalMembers == 0 ? 0.0 : schedule.availableMembers / totalMembers;

    return Row(
      children: [
        Container(
          width: 44,
          height: 44,
          decoration: BoxDecoration(
            color: AppColors.yellowSoft,
            borderRadius: BorderRadius.circular(14),
          ),
          child: const Icon(Icons.schedule_rounded, color: AppColors.yellow),
        ),
        const SizedBox(width: 12),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Text(schedule.label, style: AppText.heading),
                  Text(
                    '${schedule.availableMembers}/$totalMembers disponibles',
                    style: AppText.label,
                  ),
                ],
              ),
              const SizedBox(height: 8),
              CCProgressBar(
                value: ratio,
                height: 6,
                color: everyone ? AppColors.success : AppColors.yellow,
              ),
            ],
          ),
        ),
      ],
    );
  }
}

class _ChatCard extends StatefulWidget {
  const _ChatCard();

  @override
  State<_ChatCard> createState() => _ChatCardState();
}

class _ChatCardState extends State<_ChatCard> {
  final TextEditingController _controller = TextEditingController();

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  void _send() {
    final text = _controller.text;
    if (text.trim().isEmpty) return;
    AppScope.read(context).sendMessage(text);
    _controller.clear();
  }

  @override
  Widget build(BuildContext context) {
    final state = AppScope.of(context);
    final all = state.messages;
    final visible = all.length > 8 ? all.sublist(all.length - 8) : all;
    final myId = state.user.id;

    return CCCard(
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              const Icon(
                Icons.chat_bubble_outline_rounded,
                color: AppColors.yellow,
                size: 20,
              ),
              const SizedBox(width: 8),
              const Expanded(child: Text('Conversación del grupo', style: AppText.heading)),
              const InfoPill(label: 'Demo'),
            ],
          ),
          const SizedBox(height: 12),
          if (visible.isEmpty)
            const Padding(
              padding: EdgeInsets.symmetric(vertical: 16),
              child: Text(
                'Sé el primero en escribirle al bonche.',
                style: AppText.bodyMuted,
              ),
            )
          else
            for (final message in visible)
              _ChatBubble(
                message: message,
                author: message.authorId == null
                    ? null
                    : state.memberById(message.authorId!),
                isMine: message.authorId == myId,
              ),
          const SizedBox(height: 12),
          Row(
            crossAxisAlignment: CrossAxisAlignment.center,
            children: [
              Expanded(
                child: TextField(
                  controller: _controller,
                  textInputAction: TextInputAction.send,
                  onSubmitted: (_) => _send(),
                  minLines: 1,
                  maxLines: 3,
                  decoration: ccInputDecoration(
                    label: 'Escribe al bonche',
                    icon: Icons.chat_bubble_outline_rounded,
                  ),
                ),
              ),
              const SizedBox(width: 8),
              IconButton.filled(
                onPressed: _send,
                style: IconButton.styleFrom(
                  backgroundColor: AppColors.yellow,
                  foregroundColor: AppColors.onYellow,
                ),
                icon: const Icon(Icons.send_rounded),
              ),
            ],
          ),
        ],
      ),
    );
  }
}

class _ChatBubble extends StatelessWidget {
  const _ChatBubble({
    required this.message,
    required this.author,
    required this.isMine,
  });

  final ChatMessage message;
  final GroupMember? author;
  final bool isMine;

  @override
  Widget build(BuildContext context) {
    if (message.isSystem) {
      return Padding(
        padding: const EdgeInsets.symmetric(vertical: 6),
        child: Center(
          child: Wrap(
            alignment: WrapAlignment.center,
            children: [
              InfoPill(
                label: message.text,
                icon: Icons.check_circle_rounded,
                color: AppColors.success,
              ),
            ],
          ),
        ),
      );
    }

    final maxWidth = MediaQuery.sizeOf(context).width * 0.68;
    final textColor = isMine ? AppColors.onYellow : AppColors.textPrimary;

    return Align(
      alignment: isMine ? Alignment.centerRight : Alignment.centerLeft,
      child: ConstrainedBox(
        constraints: BoxConstraints(maxWidth: maxWidth),
        child: Container(
          margin: const EdgeInsets.symmetric(vertical: 4),
          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
          decoration: BoxDecoration(
            color: isMine ? AppColors.yellow : AppColors.surfaceAlt,
            borderRadius: BorderRadius.only(
              topLeft: const Radius.circular(16),
              topRight: const Radius.circular(16),
              bottomLeft: Radius.circular(isMine ? 16 : 4),
              bottomRight: Radius.circular(isMine ? 4 : 16),
            ),
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            mainAxisSize: MainAxisSize.min,
            children: [
              if (!isMine)
                Padding(
                  padding: const EdgeInsets.only(bottom: 2),
                  child: Text(
                    author?.firstName ?? 'Bonchero',
                    style: AppText.label.copyWith(color: AppColors.yellow),
                  ),
                ),
              Text(message.text, style: AppText.body.copyWith(color: textColor)),
              const SizedBox(height: 4),
              Text(
                formatClock(message.sentAt),
                style: AppText.label.copyWith(
                  fontSize: 10,
                  color: isMine
                      ? AppColors.onYellow.withValues(alpha: 0.65)
                      : AppColors.textSecondary,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

// -----------------------------------------------------------------------------
// RANKING
// -----------------------------------------------------------------------------

class RankingScreen extends StatefulWidget {
  const RankingScreen({super.key});

  @override
  State<RankingScreen> createState() => _RankingScreenState();
}

class _RankingScreenState extends State<RankingScreen> {
  RankingPeriod _period = RankingPeriod.weekly;

  @override
  Widget build(BuildContext context) {
    final state = AppScope.of(context);

    if (state.socialLoading) {
      return const LoadingView(label: 'Cargando el ranking...');
    }
    final error = state.socialError;
    if (error != null) {
      return ErrorStateView(message: error, onRetry: () => state.loadSocial());
    }
    final board = state.boardFor(_period);
    if (board == null) {
      return const EmptyStateView(
        icon: Icons.leaderboard_rounded,
        title: 'Aún no hay ranking',
        message: 'Completa retos con tu bonche y aquí verás la clasificación.',
      );
    }

    final entries = state.liveEntries(_period);
    final myIndex = entries.indexWhere((e) => e.memberId == state.user.id);
    final me = myIndex >= 0 ? entries[myIndex] : null;
    final groupAverage =
        board.groupSeries.isEmpty ? 0 : board.groupSeries.last.round();
    final myPoints = me?.points ?? 0;

    return ListView(
      padding: const EdgeInsets.fromLTRB(20, 8, 20, 32),
      children: [
        SegmentedTabs(
          labels: const ['Semanal', 'Mensual'],
          selected: _period == RankingPeriod.weekly ? 0 : 1,
          onChanged: (i) => setState(() {
            _period = i == 0 ? RankingPeriod.weekly : RankingPeriod.monthly;
          }),
        ),
        const SizedBox(height: 16),
        _PeriodHeaderCard(board: board),
        const SizedBox(height: 20),
        if (entries.length >= 3) ...[
          _Podium(entries: entries, state: state),
          const SizedBox(height: 24),
        ],
        const SectionTitle('Tabla de posiciones'),
        _StandingsCard(entries: entries, state: state),
        if (me != null) ...[
          const SizedBox(height: 28),
          const SectionTitle('Tus estadísticas'),
          _MyStats(
            rank: myIndex + 1,
            entry: me,
            totalChallenges: board.totalChallenges,
          ),
        ],
        const SizedBox(height: 28),
        const SectionTitle('Evolución'),
        CCCard(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              SizedBox(
                height: 190,
                width: double.infinity,
                child: CustomPaint(
                  painter: _EvolutionChartPainter(
                    labels: board.chartLabels,
                    userValues: state.liveUserSeries(_period),
                    groupValues: board.groupSeries,
                  ),
                ),
              ),
              const SizedBox(height: 12),
              const Row(
                children: [
                  _LegendDot(color: AppColors.yellow, label: 'Tú'),
                  SizedBox(width: 16),
                  _LegendDot(
                    color: AppColors.textSecondary,
                    label: 'Promedio del bonche',
                  ),
                ],
              ),
              const SizedBox(height: 12),
              Text(
                'Llevas $myPoints puntos; el promedio del bonche es $groupAverage.',
                style: AppText.bodyMuted,
              ),
            ],
          ),
        ),
        const SizedBox(height: 28),
        const SectionTitle('Historial'),
        _HistoryCard(board: board, state: state),
        const SizedBox(height: 16),
        Text(
          _period == RankingPeriod.weekly
              ? 'El ranking semanal se reinicia cada lunes. Tu historial se conserva.'
              : 'El ranking mensual se reinicia cada mes. Tu historial se conserva.',
          textAlign: TextAlign.center,
          style: AppText.label,
        ),
      ],
    );
  }
}

class _PeriodHeaderCard extends StatelessWidget {
  const _PeriodHeaderCard({required this.board});

  final RankingBoard board;

  @override
  Widget build(BuildContext context) {
    return CCCard(
