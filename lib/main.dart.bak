            children: [
              const Icon(
                Icons.restart_alt_rounded,
                color: AppColors.textSecondary,
                size: 18,
              ),
              const SizedBox(width: 10),
              Expanded(child: Text(board.resetLabel, style: AppText.bodyMuted)),
            ],
