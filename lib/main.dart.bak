// --- Permisos ----------------------------------------------------------------

/// Permisos del sistema que ChallengeUs puede necesitar. Para añadir uno
/// nuevo basta con agregarlo aquí y en [SystemPermissionService].
enum AppPermission {
  camera(
    label: 'cámara',
    rationale:
        'ChallengeUs usa la cámara para que captures la evidencia de tus retos '
        'en el momento. No se usa la galería: cada evidencia se toma aquí mismo.',
  ),
  microphone(
    label: 'micrófono',
    rationale:
        'ChallengeUs usa el micrófono solo dentro de los retos de voz, '
        'para grabar tu doblaje.',
  );

  const AppPermission({required this.label, required this.rationale});

  final String label;
  final String rationale;
}

/// Resultado simplificado y común a cualquier permiso.
enum PermissionOutcome { granted, denied, permanentlyDenied, restricted }

// --- Retos -------------------------------------------------------------------

enum ChallengeCategory {
  observacion('Observación'),
  creatividad('Creatividad'),
  movimiento('Movimiento'),
  ingenio('Ingenio');

  const ChallengeCategory(this.label);
  final String label;
}

enum ChallengeDifficulty {
  facil('Fácil'),
  medio('Medio'),
  dificil('Difícil');

  const ChallengeDifficulty(this.label);
  final String label;
}

/// Tipo de evidencia que pide un reto (hoy solo se usa la foto).
enum EvidenceType { photo, drawing, voice }

/// Estado personal del usuario frente a un reto.
enum ChallengeStatus { available, upcoming, completed, expired }

class Challenge {
  const Challenge({
    required this.id,
    required this.title,
    required this.objective,
    required this.description,
    required this.rules,
    required this.category,
    required this.difficulty,
    required this.evidenceType,
    required this.points,
    required this.xpReward,
    required this.coinReward,
    required this.startsAt,
    required this.endsAt,
    required this.completedBy,
    required this.totalMembers,
    this.requiredPermissions = const [AppPermission.camera],
  });

  final String id;
  final String title;
  final String objective;
  final String description;
  final List<String> rules;
  final ChallengeCategory category;
  final ChallengeDifficulty difficulty;
  final EvidenceType evidenceType;

  /// Permisos que hay que tener concedidos antes de capturar la evidencia.
  final List<AppPermission> requiredPermissions;

  final int points;
  final int xpReward;
  final int coinReward;
  final DateTime startsAt;
  final DateTime endsAt;

  /// Integrantes del grupo que ya lo completaron (sin contar al usuario).
  final int completedBy;
  final int totalMembers;

  Duration timeLeft(DateTime now) => endsAt.difference(now);
  Duration timeUntilStart(DateTime now) => startsAt.difference(now);
}

// --- Usuario y niveles -------------------------------------------------------

class UserProfile {
  const UserProfile({
    required this.id,
    required this.displayName,
    required this.email,
    this.xp = 0,
    this.coins = 0,
    this.streak = 0,
    this.bestStreak = 0,
    this.completedChallenges = 0,
  });

  static const UserProfile empty =
      UserProfile(id: '', displayName: '', email: '');

  final String id;
  final String displayName;
  final String email;
  final int xp;
  final int coins;
  final int streak;
  final int bestStreak;
  final int completedChallenges;

  String get firstName {
    final parts = displayName
        .trim()
        .split(RegExp(r'\s+'))
        .where((part) => part.isNotEmpty)
        .toList();
    return parts.isEmpty ? 'Jugador' : parts.first;
  }

  String get initials => initialsFromName(displayName);

  UserProfile copyWith({
    int? xp,
    int? coins,
    int? streak,
    int? bestStreak,
    int? completedChallenges,
  }) {
    return UserProfile(
      id: id,
      displayName: displayName,
      email: email,
      xp: xp ?? this.xp,
      coins: coins ?? this.coins,
      streak: streak ?? this.streak,
      bestStreak: bestStreak ?? this.bestStreak,
      completedChallenges: completedChallenges ?? this.completedChallenges,
    );
  }
}

/// Información de nivel calculada a partir del XP total.
class LevelInfo {
  const LevelInfo({
    required this.level,
    required this.title,
    required this.xpIntoLevel,
    required this.xpForNextLevel,
  });

  final int level;
  final String title;
  final int xpIntoLevel;
  final int xpForNextLevel;

  double get progress => xpIntoLevel / xpForNextLevel;
  int get xpRemaining => xpForNextLevel - xpIntoLevel;
}

/// Sistema de niveles (distinto del sistema de insignias).
class LevelSystem {
  LevelSystem._();

  static const int xpPerLevel = 100;

  static const List<String> _titles = [
    'Recién llegado',
    'Parcero',
    'Bonchero',
    'Gran Bonchero',
    'Maestro de la Terraza',
  ];

  static LevelInfo fromXp(int xp) {
    final safeXp = xp < 0 ? 0 : xp;
    final level = safeXp ~/ xpPerLevel + 1;
    final titleIndex =
        level - 1 < _titles.length ? level - 1 : _titles.length - 1;
    return LevelInfo(
      level: level,
      title: _titles[titleIndex],
      xpIntoLevel: safeXp % xpPerLevel,
      xpForNextLevel: xpPerLevel,
    );
  }
}

// --- Evidencia y recompensa --------------------------------------------------

/// Evidencia capturada con la cámara de la app para un reto.
class Evidence {
  const Evidence({
    required this.id,
    required this.challengeId,
    required this.filePath,
    required this.type,
    required this.capturedAt,
  });

  final String id;
  final String challengeId;
  final String filePath;
  final EvidenceType type;
  final DateTime capturedAt;
}

/// Resultado de validar una evidencia (hoy mock; mañana IA o el grupo).
class ValidationResult {
  const ValidationResult({required this.approved, required this.message});

  final bool approved;
  final String message;
}

/// Resultado final mostrado en la pantalla de recompensa.
class RewardResult {
  const RewardResult({
    required this.approved,
    required this.message,
    required this.challengeTitle,
    this.xpGained = 0,
    this.coinsGained = 0,
    this.streak = 0,
    this.leveledUp = false,
    this.level = 1,
    this.levelTitle = '',
    this.doubleXpUsed = false,
  });

  factory RewardResult.rejected({
    required String challengeTitle,
    required String message,
  }) {
    return RewardResult(
      approved: false,
      message: message,
      challengeTitle: challengeTitle,
    );
  }

  final bool approved;
  final String message;
  final String challengeTitle;
  final int xpGained;
  final int coinsGained;
  final int streak;
  final bool leveledUp;
  final int level;
  final String levelTitle;
  final bool doubleXpUsed;
}

