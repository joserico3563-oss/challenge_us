class ProfileScreen extends StatelessWidget {
  const ProfileScreen({super.key});

  Future<void> _logout(BuildContext context) async {
    final app = AppScope.read(context);
    final navigator = Navigator.of(context);
    await app.signOut();
    navigator.pushNamedAndRemoveUntil(AppRoutes.welcome, (route) => false);
  }

  @override
  Widget build(BuildContext context) {
    final state = AppScope.of(context);
    final user = state.user;
    final level = state.levelInfo;

    return Scaffold(
      appBar: ccAppBar('Perfil / Mi Muro'),
      body: ListView(
        padding: const EdgeInsets.fromLTRB(20, 8, 20, 32),
        children: [
          Center(child: UserAvatar(initials: user.initials, radius: 44)),
          const SizedBox(height: 16),
          Center(child: Text(user.displayName, style: AppText.title)),
          const SizedBox(height: 4),
          Center(child: Text(user.email, style: AppText.bodyMuted)),
          const SizedBox(height: 24),
          CCCard(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Text('Nivel ${level.level}', style: AppText.heading),
                    Text(
                      '${level.xpIntoLevel}/${level.xpForNextLevel} XP',
                      style: AppText.label,
                    ),
                  ],
                ),
                const SizedBox(height: 2),
                Text(level.title, style: AppText.bodyMuted),
                const SizedBox(height: 12),
                CCProgressBar(value: level.progress),
                const SizedBox(height: 8),
                Text(
                  'Te faltan ${level.xpRemaining} XP para el siguiente nivel',
                  style: AppText.label,
                ),
              ],
            ),
          ),
          const SizedBox(height: 12),
          Row(
            children: [
              Expanded(
                child: StatBox(
                  icon: Icons.monetization_on_rounded,
                  value: '${user.coins}',
                  label: 'MONEDAS',
                ),
              ),
              const SizedBox(width: 12),
              Expanded(
                child: StatBox(
                  icon: Icons.local_fire_department_rounded,
                  color: AppColors.orange,
                  value: '${user.streak}',
                  label: 'RACHA',
                ),
              ),
              const SizedBox(width: 12),
              Expanded(
                child: StatBox(
                  icon: Icons.check_circle_rounded,
                  color: AppColors.success,
                  value: '${user.completedChallenges}',
                  label: 'RETOS',
                ),
              ),
            ],
          ),
          const SizedBox(height: 16),
          const CCCard(
            child: Row(
              children: [
                Icon(Icons.emoji_events_rounded, color: AppColors.yellow),
                SizedBox(width: 12),
                Expanded(
                  child: Text(
                    'Muy pronto: tus insignias, estadísticas y logros en un solo muro.',
                    style: AppText.bodyMuted,
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(height: 24),
          SecondaryButton(
            label: 'Cerrar sesión',
            icon: Icons.logout_rounded,
            onPressed: () => _logout(context),
          ),
        ],
      ),
    );
  }
}

// -----------------------------------------------------------------------------
// BONCHE
// -----------------------------------------------------------------------------

class BoncheScreen extends StatelessWidget {
  const BoncheScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final state = AppScope.of(context);

    if (state.socialLoading) {
      return const LoadingView(label: 'Cargando tu bonche...');
    }
    final error = state.socialError;
    if (error != null) {
      return ErrorStateView(message: error, onRetry: () => state.loadSocial());
    }
    final group = state.group;
    if (group == null) {
      return const EmptyStateView(
        icon: Icons.groups_rounded,
        title: 'Aún no tienes bonche',
        message: 'Cuando te unas a un grupo privado, aparecerá aquí.',
      );
    }

    final members = state.members;
    return ListView(
      padding: const EdgeInsets.fromLTRB(20, 8, 20, 32),
      children: [
        _GroupHeaderCard(
          group: group,
          memberCount: members.length,
          leader: state.memberById(group.leaderId),
        ),
        const SizedBox(height: 12),
        _InviteCodeCard(code: group.inviteCode),
        const SizedBox(height: 28),
        const SectionTitle('Integrantes'),
        _MembersCard(
          members: members,
          leaderId: group.leaderId,
          myId: state.user.id,
        ),
        const SizedBox(height: 28),
        const SectionTitle('Retos del bonche'),
        _ChallengeSettings(group: group, totalMembers: members.length),
        const SizedBox(height: 28),
        const SectionTitle('Charla del bonche'),
        const _ChatCard(),
      ],
    );
  }
}

class _GroupHeaderCard extends StatelessWidget {
  const _GroupHeaderCard({
    required this.group,
    required this.memberCount,
    required this.leader,
  });

  final GroupInfo group;
  final int memberCount;
  final GroupMember? leader;

  @override
  Widget build(BuildContext context) {
    final since = '${kMonthsLong[group.createdAt.month - 1].toLowerCase()} de ${group.createdAt.year}';

    return CCCard(
      highlight: true,
      padding: const EdgeInsets.all(20),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Container(
                width: 64,
                height: 64,
                decoration: BoxDecoration(
                  color: AppColors.yellow,
                  borderRadius: BorderRadius.circular(20),
                ),
                child: const Icon(
                  Icons.groups_rounded,
                  color: AppColors.onYellow,
                  size: 34,
                ),
              ),
              const SizedBox(width: 14),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(group.name, style: AppText.title),
                    const SizedBox(height: 4),
                    Text(group.tagline, style: AppText.bodyMuted),
                  ],
                ),
              ),
            ],
          ),
          const SizedBox(height: 16),
          Wrap(
            spacing: 8,
            runSpacing: 8,
            children: [
              const InfoPill(
                label: 'Grupo privado',
                icon: Icons.lock_rounded,
                color: AppColors.yellow,
              ),
              InfoPill(label: '$memberCount integrantes', icon: Icons.groups_rounded),
              InfoPill(
                label: 'Líder: ${leader?.firstName ?? '-'}',
                icon: Icons.workspace_premium_rounded,
                color: AppColors.orange,
              ),
            ],
          ),
          const SizedBox(height: 12),
          Text('Activo desde $since', style: AppText.label),
        ],
      ),
    );
  }
}

class _InviteCodeCard extends StatelessWidget {
  const _InviteCodeCard({required this.code});

  final String code;

  Future<void> _copy(BuildContext context) async {
    await Clipboard.setData(ClipboardData(text: code));
    if (!context.mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(content: Text('Código copiado. ¡Compártelo con tu parche!')),
    );
  }

  @override
  Widget build(BuildContext context) {
    return CCCard(
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Container(
                width: 44,
                height: 44,
                decoration: BoxDecoration(
                  color: AppColors.yellowSoft,
                  borderRadius: BorderRadius.circular(14),
                ),
                child: const Icon(Icons.vpn_key_rounded, color: AppColors.yellow),
              ),
              const SizedBox(width: 12),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const Text('CÓDIGO DE INVITACIÓN', style: AppText.label),
                    const SizedBox(height: 2),
                    Text(
                      code,
                      style: AppText.heading.copyWith(letterSpacing: 1.5),
                    ),
                  ],
                ),
              ),
              TextButton.icon(
                onPressed: () => _copy(context),
                icon: const Icon(Icons.content_copy_rounded, size: 18),
                label: const Text('Copiar'),
              ),
            ],
          ),
          const SizedBox(height: 10),
          const Text(
            'El bonche es privado: solo entra quien tenga este código.',
            style: AppText.bodyMuted,
          ),
        ],
      ),
    );
  }
}

class _MembersCard extends StatelessWidget {
  const _MembersCard({
    required this.members,
    required this.leaderId,
    required this.myId,
  });

  final List<GroupMember> members;
  final String leaderId;
  final String myId;

  @override
  Widget build(BuildContext context) {
    return CCCard(
      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 6),
      child: Column(
        children: [
          for (var i = 0; i < members.length; i++) ...[
            _MemberRow(
              member: members[i],
              isLeader: members[i].id == leaderId,
              isMe: members[i].id == myId,
            ),
            if (i != members.length - 1)
              const Divider(height: 1, color: AppColors.border),
          ],
        ],
      ),
    );
  }
}

