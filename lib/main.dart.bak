class MainShell extends StatefulWidget {
  const MainShell({super.key});

  @override
  State<MainShell> createState() => _MainShellState();
}

class _MainShellState extends State<MainShell> {
  int _index = 0;

  void _openProfile() {
    Navigator.of(context).pushNamed(AppRoutes.profile);
  }

  void _openNotifications() {
    showModalBottomSheet<void>(
      context: context,
      backgroundColor: AppColors.surface,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
      ),
      builder: (_) => const SizedBox(
        height: 300,
        child: EmptyStateView(
          icon: Icons.notifications_none_rounded,
          title: 'Sin notificaciones',
          message:
              'Aquí verás cuando salga un reto nuevo o tu bonche te escriba.',
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final user = AppScope.of(context).user;

    return PopScope(
      canPop: _index == 0,
      onPopInvokedWithResult: (didPop, result) {
        if (!didPop) setState(() => _index = 0);
      },
      child: Scaffold(
        appBar: AppBar(
          automaticallyImplyLeading: false,
          backgroundColor: AppColors.background,
          surfaceTintColor: Colors.transparent,
          scrolledUnderElevation: 0,
          titleSpacing: 20,
          title: const AppLogo(size: 28),
          actions: [
            IconButton(
              tooltip: 'Notificaciones',
              onPressed: _openNotifications,
              icon: const Icon(Icons.notifications_none_rounded),
            ),
            Padding(
              padding: const EdgeInsets.only(left: 4, right: 16),
              child: InkWell(
                customBorder: const CircleBorder(),
                onTap: _openProfile,
                child: UserAvatar(initials: user.initials),
              ),
            ),
          ],
        ),
        body: IndexedStack(
          index: _index,
          children: const [
            HomeScreen(),
            BoncheScreen(),
            RankingScreen(),
            StoreScreen(),
          ],
        ),
        bottomNavigationBar: NavigationBar(
          selectedIndex: _index,
          onDestinationSelected: (i) => setState(() => _index = i),
          backgroundColor: AppColors.surface,
          surfaceTintColor: Colors.transparent,
          destinations: const [
            NavigationDestination(
              icon: Icon(Icons.home_outlined),
              selectedIcon: Icon(Icons.home_rounded),
              label: 'Inicio',
            ),
            NavigationDestination(
              icon: Icon(Icons.groups_outlined),
              selectedIcon: Icon(Icons.groups_rounded),
              label: 'Bonche',
            ),
            NavigationDestination(
              icon: Icon(Icons.leaderboard_outlined),
              selectedIcon: Icon(Icons.leaderboard_rounded),
              label: 'Ranking',
            ),
            NavigationDestination(
              icon: Icon(Icons.storefront_outlined),
              selectedIcon: Icon(Icons.storefront_rounded),
              label: 'Tienda',
            ),
          ],
        ),
      ),
    );
  }
}

// -----------------------------------------------------------------------------
// Inicio
// -----------------------------------------------------------------------------

class HomeScreen extends StatelessWidget {
  const HomeScreen({super.key});

  void _openChallenge(BuildContext context, Challenge challenge) {
    Navigator.of(context).pushNamed(
      AppRoutes.challengeDetail,
      arguments: challenge.id,
    );
  }

  List<Widget> _buildContent(BuildContext context, AppState state, DateTime now) {
    if (state.challengesLoading) {
      return const [
        SizedBox(height: 280, child: LoadingView(label: 'Cargando tus retos...')),
      ];
    }
    final error = state.challengesError;
    if (error != null) {
      return [ErrorStateView(message: error, onRetry: () => state.loadChallenges())];
    }
    final focus = state.focusChallenge(now);
    if (focus == null) {
      return const [
        EmptyStateView(
          icon: Icons.emoji_events_rounded,
          title: 'Hoy no hay retos',
          message: 'Cuando tu bonche tenga un reto, aparecerá aquí.',
        ),
      ];
    }

    final others = state.otherChallenges(now);
    return [
      ChallengeHeroCard(
        challenge: focus,
        status: state.statusOf(focus, now),
        now: now,
        groupCompleted: state.groupCompleted(focus),
        onTap: () => _openChallenge(context, focus),
      ),
      if (others.isNotEmpty) ...[
        const SizedBox(height: 28),
        const Text('Más retos de hoy', style: AppText.heading),
        const SizedBox(height: 12),
        for (final challenge in others)
          Padding(
            padding: const EdgeInsets.only(bottom: 12),
            child: _ChallengeTile(
              challenge: challenge,
              status: state.statusOf(challenge, now),
              now: now,
              onTap: () => _openChallenge(context, challenge),
            ),
          ),
      ],
    ];
  }

  @override
  Widget build(BuildContext context) {
    return TickBuilder(
      builder: (context, now) {
        final state = AppScope.of(context);
        final user = state.user;
        final level = state.levelInfo;
        final streakText =
            'Racha ${user.streak} ${user.streak == 1 ? 'día' : 'días'}';

        return ListView(
          padding: const EdgeInsets.fromLTRB(20, 8, 20, 32),
          children: [
            Text('Hola, ${user.firstName}', style: AppText.title),
            const SizedBox(height: 4),
            const Text(
              'Hoy hay bonche. ¿Vas pa esa?',
              style: AppText.bodyMuted,
            ),
            const SizedBox(height: 16),
            Wrap(
              spacing: 8,
              runSpacing: 8,
              children: [
                ValueChip(
                  icon: Icons.monetization_on_rounded,
                  text: '${user.coins} monedas',
                  color: AppColors.yellow,
                ),
                ValueChip(
                  icon: Icons.local_fire_department_rounded,
                  text: streakText,
                  color: AppColors.orange,
                ),
                ValueChip(
                  icon: Icons.military_tech_rounded,
                  text: 'Nivel ${level.level}',
                  color: AppColors.textSecondary,
                ),
              ],
            ),
            const SizedBox(height: 20),
            ..._buildContent(context, state, now),
          ],
        );
      },
    );
  }
}

class _ChallengeTile extends StatelessWidget {
  const _ChallengeTile({
    required this.challenge,
    required this.status,
    required this.now,
    required this.onTap,
  });

  final Challenge challenge;
  final ChallengeStatus status;
  final DateTime now;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return CCCard(
      padding: const EdgeInsets.all(14),
      onTap: onTap,
      child: Row(
        children: [
          Container(
            width: 44,
            height: 44,
            decoration: BoxDecoration(
              color: AppColors.yellowSoft,
              borderRadius: BorderRadius.circular(14),
            ),
            child: Icon(challenge.category.icon, color: AppColors.yellow),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  challenge.title,
                  style: AppText.heading,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                ),
                const SizedBox(height: 2),
                Text(
                  challengeTimeLabel(challenge, status, now),
                  style: AppText.bodyMuted,
                ),
              ],
            ),
          ),
          const SizedBox(width: 8),
          InfoPill(label: status.label, icon: status.icon, color: status.color),
        ],
      ),
    );
  }
}

// -----------------------------------------------------------------------------
// Detalle del reto
// -----------------------------------------------------------------------------

class ChallengeDetailScreen extends StatelessWidget {
  const ChallengeDetailScreen({super.key, required this.challengeId});

  final String challengeId;

  @override
  Widget build(BuildContext context) {
    return TickBuilder(
      builder: (context, now) {
        final state = AppScope.of(context);
        final challenge = state.challengeById(challengeId);

        if (challenge == null) {
          return Scaffold(
            appBar: ccAppBar('Reto'),
            body: ErrorStateView(
              message: 'No encontramos este reto.',
              retryLabel: 'Volver',
              onRetry: () => Navigator.of(context).maybePop(),
            ),
          );
        }

        final status = state.statusOf(challenge, now);
        final canCapture = status == ChallengeStatus.available;
        final buttonLabel = switch (status) {
          ChallengeStatus.available => 'Capturar evidencia',
          ChallengeStatus.upcoming => 'Aún no empieza',
          ChallengeStatus.completed => 'Reto completado',
          ChallengeStatus.expired => 'Tiempo agotado',
        };

        return Scaffold(
          appBar: ccAppBar('Detalle del reto'),
          body: ListView(
            padding: const EdgeInsets.fromLTRB(20, 8, 20, 24),
            children: [
              Wrap(
                spacing: 8,
                runSpacing: 8,
                children: [
                  InfoPill(
                    label: challenge.category.label,
                    icon: challenge.category.icon,
                    color: AppColors.yellow,
                  ),
                  InfoPill(
                    label: challenge.difficulty.label,
                    color: challenge.difficulty.color,
                  ),
                  InfoPill(label: status.label, icon: status.icon, color: status.color),
                ],
              ),
              const SizedBox(height: 14),
              Text(challenge.title, style: AppText.display),
              const SizedBox(height: 20),
              CCCard(
                child: Row(
                  children: [
                    const Icon(Icons.timer_outlined, color: AppColors.yellow),
                    const SizedBox(width: 12),
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          const Text('TIEMPO', style: AppText.label),
                          const SizedBox(height: 2),
                          Text(
                            challengeTimeLabel(challenge, status, now),
                            style: AppText.heading,
                          ),
                          const SizedBox(height: 2),
                          Text(
                            'Ventana: ${formatClock(challenge.startsAt)} - ${formatClock(challenge.endsAt)}',
                            style: AppText.bodyMuted,
                          ),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
              const SizedBox(height: 12),
              Row(
                children: [
                  Expanded(
                    child: _InfoTile(
                      icon: Icons.stars_rounded,
                      label: 'PUNTUACIÓN',
                      value: '${challenge.points} pts',
                    ),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: _InfoTile(
                      icon: Icons.card_giftcard_rounded,
                      label: 'RECOMPENSA',
                      value: '+${challenge.xpReward} XP\n+${challenge.coinReward} monedas',
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 24),
              const Text('Objetivo', style: AppText.heading),
              const SizedBox(height: 8),
              Text(challenge.objective, style: AppText.body),
              const SizedBox(height: 20),
              const Text('Descripción', style: AppText.heading),
              const SizedBox(height: 8),
              Text(challenge.description, style: AppText.bodyMuted),
              const SizedBox(height: 20),
              const Text('Reglas', style: AppText.heading),
              const SizedBox(height: 10),
              CCCard(
                child: Column(
                  children: [
                    for (var i = 0; i < challenge.rules.length; i++)
                      Padding(
                        padding: EdgeInsets.only(
                          bottom: i == challenge.rules.length - 1 ? 0 : 12,
                        ),
                        child: _RuleRow(number: i + 1, text: challenge.rules[i]),
                      ),
                  ],
                ),
              ),
            ],
          ),
          bottomNavigationBar: SafeArea(
            child: Padding(
              padding: const EdgeInsets.fromLTRB(20, 8, 20, 16),
              child: PrimaryButton(
                label: buttonLabel,
                icon: canCapture ? Icons.camera_alt_rounded : null,
                onPressed: canCapture
                    ? () => Navigator.of(context).pushNamed(
                          AppRoutes.evidenceCapture,
                          arguments: challenge.id,
                        )
                    : null,
              ),
            ),
          ),
        );
      },
    );
  }
}

